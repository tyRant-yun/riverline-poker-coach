# 复制为仓库根目录的 .env 并按需填写；应用启动时自动加载（不覆盖已设置的环境变量）。
# Copy this file to .env in the repository root and fill in values.
# The app loads it automatically at startup (existing environment wins).

# --- 服务器标识 ---
# POKER_COACH_APP_VERSION=0.1.0
# POKER_COACH_ANALYSIS_VERSION=analysis-core-0.1

# --- 存储：默认 SQLite；设置 POKER_COACH_DATABASE_URL 后切换 PostgreSQL ---
# POKER_COACH_DB_PATH=.data/poker_coach.sqlite3
# POKER_COACH_DATABASE_URL=postgresql://coach:coach@127.0.0.1:55432/coach

# --- 分析作业：默认进程内线程池；设置 POKER_COACH_REDIS_URL 后切换 Redis 队列 ---
# 部署独立 worker 时设 POKER_COACH_REDIS_WORKER_IN_PROCESS=0
# POKER_COACH_REDIS_URL=redis://127.0.0.1:56379/0
# POKER_COACH_REDIS_WORKER_IN_PROCESS=1

# --- 教学 Agent：设置 API Key 后从本地教师切换为外部模型教师 ---
# DeepSeek 示例（OpenAI 兼容端点，无需改代码）：
# POKER_COACH_LLM_BASE_URL=https://api.deepseek.com/v1
# POKER_COACH_LLM_API_KEY=sk-your-deepseek-key
# POKER_COACH_LLM_MODEL=deepseek-chat
# POKER_COACH_LLM_TIMEOUT_SECONDS=60

# --- 请求限制与行为 ---
# POKER_COACH_MAX_REQUEST_BYTES=1000000
# POKER_COACH_MAX_TIMEOUT_SECONDS=120
# POKER_COACH_RATE_LIMIT_PER_MINUTE=120
# POKER_COACH_STORE_USER_TEXT=0

# --- 测试（可选）：真实 PostgreSQL 部署回归 ---
# POKER_COACH_TEST_PG_URL=postgresql://coach:coach@127.0.0.1:55432/coach_test
